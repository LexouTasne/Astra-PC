{
  "camera": {
    "index": 0,
    "width": 640,
    "height": 360,
    "target_fps": 30,
    "mirror": true
  },
  "tracking": {
    "max_hands": 2,
    "min_detection_confidence": 0.65,
    "min_tracking_confidence": 0.6,
    "model_complexity": 1
  },
  "pointer": {
    "enabled": false,
    "active_margin": 0.1,
    "smoothing": 0.3,
    "deadzone_px": 1
  },
  "gestures": {
    "pinch_threshold": 0.05,
    "click_release_threshold": 0.075,
    "right_pinch_threshold": 0.055,
    "drag_enabled": false,
    "drag_hold_ms": 420,
    "pause_cooldown_ms": 850,
    "scroll_gain": 45,
    "scroll_deadzone": 0.0025,
    "swipe_velocity": 0.6,
    "swipe_cooldown_ms": 650,
    "two_hand_zoom_threshold": 0.025,
    "two_hand_rotate_threshold_deg": 7.5,
    "pause_hold_ms": 420,
    "scroll_smoothing": 0.45,
    "scroll_max_step": 4,
    "swipe_distance": 0.11,
    "swipe_window_ms": 280
  },
  "actions": {
    "zoom_in": [
      "ctrl",
      "+"
    ],
    "zoom_out": [
      "ctrl",
      "-"
    ],
    "swipe_right": [
      "alt",
      "tab"
    ],
    "swipe_left": [
      "alt",
      "shift",
      "tab"
    ],
    "rotate_right": [],
    "rotate_left": []
  },
  "ai": {
    "provider": "ollama",
    "host": "http://127.0.0.1:11434",
    "text_model": "qwen3-vl:2b-instruct",
    "vision_model": "qwen3-vl:2b-instruct",
    "timeout": 180,
    "keep_alive": -1,
    "fast_context": 2048,
    "vision_context": 6144,
    "strong_model": "",
    "fast_model": "qwen3:0.6b",
    "text_context": 6144
  },
  "voice": {
    "engine": "fast",
    "whisper_model": "small",
    "language": "pt",
    "wake_word": "astra",
    "silence_ms": 480,
    "pre_roll_ms": 300,
    "adaptive_retry": true,
    "target_response_ms": 7000,
    "conversation_window": 12,
    "dedicated_wakeword": {
      "enabled": false,
      "model_path": "",
      "threshold": 0.55
    },
    "piper_model": "",
    "start_speech_ms": 60,
    "min_utterance_ms": 180,
    "max_utterance_s": 18,
    "vad_mode": 2
  },
  "media": {
    "comfyui": {
      "host": "http://127.0.0.1:8188",
      "timeout": 900,
      "image_workflow": "workflows/image_basic.json",
      "checkpoint": ""
    }
  },
  "daemon": {
    "host": "127.0.0.1",
    "port": 8765,
    "context_interval": 0.75,
    "memory_path": "~/.local/share/astra-pc/astra.db",
    "autostart": false,
    "cache_path": "~/.cache/astra-pc/responses.db",
    "cache_ttl": 86400
  },
  "profiles": {
    "active": "default",
    "default": {
      "description": "Balanced everyday mode"
    },
    "dev": {
      "description": "Programming mode",
      "preferred_apps": [
        "vscode",
        "terminal",
        "browser"
      ]
    },
    "gaming": {
      "description": "Minimal interruptions and lightweight telemetry"
    },
    "study": {
      "description": "Focused study profile with browser and notes"
    }
  },
  "accessibility": {
    "enabled": true,
    "max_elements": 100
  },
  "proactive": {
    "enabled": true,
    "interval": 5,
    "cpu_threshold": 92,
    "ram_threshold": 92
  },
  "memory": {
    "embedding_model": "qwen3-embedding:0.6b",
    "embedding_timeout": 25,
    "max_results": 6
  },
  "skills": {
    "plugin_dir": "~/.local/share/astra-pc/skills"
  },
  "browser": {
    "cdp": "http://127.0.0.1:9222"
  },
  "performance": {
    "cpu_high": 85,
    "ram_high": 88
  },
  "gesture_profiles": {
    "browser": {
      "match": [
        "firefox",
        "chrome",
        "chromium",
        "brave",
        "edge"
      ],
      "actions": {
        "zoom_in": [
          "ctrl",
          "+"
        ],
        "zoom_out": [
          "ctrl",
          "-"
        ],
        "swipe_right": [
          "alt",
          "right"
        ],
        "swipe_left": [
          "alt",
          "left"
        ]
      }
    },
    "blender": {
      "match": [
        "blender"
      ],
      "actions": {
        "zoom_in": [
          "+"
        ],
        "zoom_out": [
          "-"
        ],
        "rotate_right": [],
        "rotate_left": []
      }
    }
  },
  "mobile": {
    "host": "0.0.0.0",
    "port": 8766,
    "enabled": true
  },
  "gaze": {
    "enabled": false
  },
  "depth": {
    "enabled": false,
    "model_path": ""
  },
  "spatial": {
    "openxr": false
  },
  "pose": {
    "enabled": false
  },
  "face_profiles": {
    "enabled": false,
    "local_only": true
  },
  "mesh": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 8767,
    "name": "",
    "state_path": "~/.local/share/astra-pc/mesh",
    "discovery": true,
    "pairing_ttl": 300,
    "sensor_rate_limit_hz": 30,
    "sync_memory": false,
    "sync_clipboard": "manual",
    "allow_remote_over_vpn": true
  }
}
