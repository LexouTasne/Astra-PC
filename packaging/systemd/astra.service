[Unit]
Description=Astra-PC resident local assistant
After=graphical-session.target network.target

[Service]
Type=simple
WorkingDirectory=%h/Astra-PC
ExecStart=%h/Astra-PC/.venv/bin/python -m astra_pc daemon
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
